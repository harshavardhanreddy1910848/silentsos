<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="40dp">

        <!-- Top Crimson Glow Accent -->
        <View
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="-80dp"
            android:alpha="0.25"
            android:background="@drawable/bg_auth_top_accent_glow" />

        <LinearLayout
            android:id="@+id/llAdminContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Logo Header -->
            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_auth_logo_badge">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield_alert_vector"
                    app:tint="#e11d48" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:letterSpacing="0.08"
                android:text="SOS ADMINISTRATIVE"
                android:textColor="@color/white"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.03"
                android:text="Authorized security personnel only"
                android:textColor="#94a3b8"
                android:textSize="12.5sp" />

            <!-- Login Form Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_card_surface"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Error Banner -->
                <TextView
                    android:id="@+id/tvAdminError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_badge_red"
                    android:padding="12dp"
                    android:textColor="#f87171"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Email Input Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="ADMIN EMAIL"
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_input_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_mail_vector"
                        app:tint="#64748b" />

                    <EditText
                        android:id="@+id/etAdminEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:background="@null"
                        android:hint="admin@silentsos.com"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/white"
                        android:textColorHint="#475569"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Password Input Label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:letterSpacing="0.05"
                    android:text="SECURITY PASSWORD"
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_auth_input_selector"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_lock_vector"
                        app:tint="#64748b" />

                    <EditText
                        android:id="@+id/etAdminPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="••••••••"
                        android:inputType="textPassword"
                        android:textColor="@color/white"
                        android:textColorHint="#475569"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/ivAdminTogglePassword"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_eye_vector"
                        app:tint="#64748b" />
                </LinearLayout>

                <!-- Authenticate Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnAdminSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/bg_auth_btn_primary"
                    android:letterSpacing="0.04"
                    android:text="AUTHENTICATE SYSTEM ›"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Progress Bar -->
                <ProgressBar
                    android:id="@+id/pbAdminLoading"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:indeterminateTint="#e11d48"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Back Link -->
            <TextView
                android:id="@+id/tvAdminBackToUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:text="← Return to Silent SOS User Portal"
                android:textColor="#94a3b8"
                android:textSize="12.5sp" />

        </LinearLayout>

    </RelativeLayout>
</ScrollView>

