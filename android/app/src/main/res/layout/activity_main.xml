<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090e">

    <!-- Main Content Container for Tab Views -->
    <FrameLayout
        android:id="@+id/containerContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav" />

    <!-- Bottom Navigation Bar matching BottomNav.tsx -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:background="#07090e"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:weightSum="6"
        android:elevation="8dp">

        <!-- Top divider line -->
        <!-- 1: SOS Hub -->
        <LinearLayout
            android:id="@+id/navSosHub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavSos"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_home_nav"
                app:tint="#00E676" />

            <TextView
                android:id="@+id/tvNavSos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="SOS Hub"
                android:textColor="#00E676"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2: Gestures -->
        <LinearLayout
            android:id="@+id/navGestures"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavGestures"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_hand_nav"
                app:tint="#64748b" />

            <TextView
                android:id="@+id/tvNavGestures"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Gestures"
                android:textColor="#64748b"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 3: Evidence -->
        <LinearLayout
            android:id="@+id/navEvidence"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavEvidence"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_file_nav"
                app:tint="#64748b" />

            <TextView
                android:id="@+id/tvNavEvidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Evidence"
                android:textColor="#64748b"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 4: Contacts -->
        <LinearLayout
            android:id="@+id/navContacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavContacts"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_users_nav"
                app:tint="#64748b" />

            <TextView
                android:id="@+id/tvNavContacts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Contacts"
                android:textColor="#64748b"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 5: History -->
        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavHistory"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_clock_nav"
                app:tint="#64748b" />

            <TextView
                android:id="@+id/tvNavHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="History"
                android:textColor="#64748b"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 6: Settings -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivNavSettings"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_settings_nav"
                app:tint="#64748b" />

            <TextView
                android:id="@+id/tvNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Settings"
                android:textColor="#64748b"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
