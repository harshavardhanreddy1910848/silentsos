<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#07090e"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/viewSurveillancePulseDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_badge_green" />

            <TextView
                android:id="@+id/tvSurveillanceTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="PHOTO BURST VIEWFINDER"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.05" />

            <ImageView
                android:id="@+id/btnCloseSurveillance"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_pill_dark"
                android:padding="6dp"
                android:src="@drawable/ic_close_vector"
                app:tint="#94a3b8" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSurveillanceSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Instantaneous 10-shot dual-facing buffer capture"
            android:textColor="#94a3b8"
            android:textSize="10.5sp" />

        <!-- Camera Viewfinder Container (for Photo & Video) -->
        <FrameLayout
            android:id="@+id/layoutCameraContainer"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="12dp"
            android:background="#0b0f19">

            <!-- Live Camera TextureView Preview -->
            <TextureView
                android:id="@+id/textureViewFinder"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Tactical Viewfinder Overlay / Reticle -->
            <FrameLayout
                android:id="@+id/layoutTacticalOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <!-- Top Row: Resolution & Switch Camera -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvLensFacing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#99000000"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:text="FRONT SENSOR • 1080p"
                        android:textColor="#38bdf8"
                        android:textSize="9sp"
                        android:fontFamily="monospace" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/btnFlipLens"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="🔄 Flip Lens"
                        android:textColor="@color/white"
                        android:textSize="9.5sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Recording indicator for video -->
                <LinearLayout
                    android:id="@+id/layoutRecIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:background="#cc111827"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_badge_red" />

                    <TextView
                        android:id="@+id/tvRecTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="REC 00:00"
                        android:textColor="#f87171"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Crosshair Grid Center -->
                <ImageView
                    android:id="@+id/ivCrosshair"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_danger_vector"
                    app:tint="#4438bdf8" />

                <!-- Bottom Telemetry Overlay -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:background="#99000000"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/tvTelemetryGps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS: LAT 13.0289° N | LNG 80.0107° E"
                        android:textColor="#10b981"
                        android:textSize="9sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/tvTelemetrySecurity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AES-256 ENCRYPTED BUFFER • TAMPER SEAL ARMED"
                        android:textColor="#94a3b8"
                        android:textSize="8.5sp"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Shutter Flash Animation overlay -->
                <View
                    android:id="@+id/viewShutterFlash"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:visibility="gone" />

                <!-- Captured Burst Preview Thumbnail (after burst) -->
                <ImageView
                    android:id="@+id/ivBurstPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>

        <!-- Audio Monitor Container (for Audio Mode) -->
        <LinearLayout
            android:id="@+id/layoutAudioContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:background="#0b0f19"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_mic_vector"
                app:tint="#22d3ee" />

            <TextView
                android:id="@+id/tvAudioMonitorStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="STEREO NOISE FILTER ACTIVE"
                android:textColor="#22d3ee"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvAudioDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="RECORDING AUDIO BUFFER: 00:00"
                android:textColor="#f87171"
                android:textSize="11sp"
                android:fontFamily="monospace" />

            <!-- Simulated Visualizer Bars -->
            <LinearLayout
                android:id="@+id/layoutAudioVisualizer"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="horizontal">

                <View android:layout_width="3dp" android:layout_height="18dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="32dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="12dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="38dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="26dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="44dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="20dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="36dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="16dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="40dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="28dp" android:layout_margin="2dp" android:background="#22d3ee" />
                <View android:layout_width="3dp" android:layout_height="14dp" android:layout_margin="2dp" android:background="#22d3ee" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Automatic acoustic voice isolation • 48kHz stereo"
                android:textColor="#64748b"
                android:textSize="9.5sp" />
        </LinearLayout>

        <!-- Dynamic Action Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSurveillanceAction"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_auth_btn_primary"
            android:text="📸 TRIGGER 10-SHOT BURST"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Status Result Message -->
        <TextView
            android:id="@+id/tvSurveillanceResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Tap to capture and archive into AES-256 evidence vault"
            android:textColor="#94a3b8"
            android:textSize="10.5sp" />

    </LinearLayout>
</FrameLayout>

