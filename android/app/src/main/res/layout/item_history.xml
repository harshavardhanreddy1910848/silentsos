<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHistType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 Emergency SOS"
                android:textColor="@color/white"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_auth_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Sent"
                android:textColor="#10b981"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHistTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="2h ago"
            android:textColor="#64748b"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvHistCoords"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="📍 17.4485° N, 78.3908° E"
        android:textColor="#94a3b8"
        android:textSize="12sp" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvHistEvidenceSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Evidence: 5 photos, 1 audio"
            android:textColor="#64748b"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/btnHistCopyLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="#0f172a"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Copy Receiver Link"
            android:textColor="#22d3ee"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

</LinearLayout>

