<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Name, Relationship Badge, Delete -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/btnItemDelete"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvItemContactName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Name"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Relationship Badge -->
            <TextView
                android:id="@+id/tvItemRelationship"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_auth_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="Family"
                android:textColor="#ff5770"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Primary Star Badge -->
            <TextView
                android:id="@+id/tvItemPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="#241a06"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="★ PRIMARY"
                android:textColor="#eab308"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnItemDelete"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_trash_vector"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Phone and Email -->
    <TextView
        android:id="@+id/tvItemContactPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="+91 98765 43210"
        android:textColor="#94a3b8"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/tvItemContactEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="contact@example.com"
        android:textColor="#64748b"
        android:textSize="11.5sp" />

    <!-- Preferences Badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#0f172a"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="4dp"
            android:text="📍 GPS"
            android:textColor="#22d3ee"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#0f172a"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="4dp"
            android:text="📷 Photo"
            android:textColor="#10b981"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#0f172a"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginEnd="4dp"
            android:text="🎤 Audio"
            android:textColor="#f59e0b"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#0f172a"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="💬 SMS"
            android:textColor="#f43f5e"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
