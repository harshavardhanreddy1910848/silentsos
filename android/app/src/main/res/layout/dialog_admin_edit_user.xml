<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit User Account"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDialogUserId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#64748b"
        android:textSize="11sp" />

    <!-- Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Full Name"
        android:textColor="#94a3b8"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogUserName"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_auth_input_selector"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <!-- Email -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Email Address"
        android:textColor="#94a3b8"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogUserEmail"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_auth_input_selector"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textSize="13sp" />

    <!-- Role Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="System Role"
        android:textColor="#94a3b8"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_auth_tab_bar"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/tvDialogRoleUser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_auth_tab_active"
            android:gravity="center"
            android:text="User"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogRoleAdmin"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Admin"
            android:textColor="#94a3b8"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Account Status Toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Disable / Lock Account"
            android:textColor="#94a3b8"
            android:textSize="12sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDialogDisabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Optional New Password -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Set New Password (optional)"
        android:textColor="#94a3b8"
        android:textSize="11.5sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDialogUserPassword"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_auth_input_selector"
        android:hint="Leave empty to keep unchanged"
        android:inputType="textPassword"
        android:paddingHorizontal="12dp"
        android:textColor="@color/white"
        android:textColorHint="#475569"
        android:textSize="13sp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_card_surface"
            android:paddingHorizontal="16dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#94a3b8"
            android:textSize="12.5sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDialogSaveUser"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_auth_btn_primary"
            android:paddingHorizontal="18dp"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
