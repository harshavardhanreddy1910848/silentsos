<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090e"
    android:orientation="vertical">

    <!-- ─── TOP APP BAR ──────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0d111a"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to Settings"
            android:src="@drawable/ic_arrow_left_vector"
            app:tint="#94a3b8" />

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_sparkle_vector"
            app:tint="#38bdf8" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Defense Assistant"
                    android:textColor="@color/white"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_badge_cyan"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1.5dp"
                    android:text="112 SOURCES"
                    android:textColor="#38bdf8"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Zero External APIs • Self-Hosted Local Brain"
                android:textColor="#94a3b8"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnAiClear"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear conversation"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#64748b" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1e293b" />

    <!-- ─── CHAT MESSAGES SCROLL CONTAINER ───────────────────────────── -->
    <ScrollView
        android:id="@+id/scrollAiMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <LinearLayout
            android:id="@+id/llAiMessageContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="4dp" />
    </ScrollView>

    <!-- Typing / Progress Indicator -->
    <TextView
        android:id="@+id/tvAiThinking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="4dp"
        android:text="⚡ Defense AI is formulating response..."
        android:textColor="#38bdf8"
        android:textSize="11sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <!-- Suggestion Chips Container -->
    <HorizontalScrollView
        android:id="@+id/scrollSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:paddingHorizontal="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/llAiSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp" />
    </HorizontalScrollView>

    <!-- ─── INPUT BAR ────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0b0f19"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <EditText
            android:id="@+id/etAiQuery"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:hint="Ask AI about CPR, PIN, Stalking, STEM..."
            android:imeOptions="actionSend"
            android:inputType="textCapSentences"
            android:paddingHorizontal="14dp"
            android:textColor="@color/white"
            android:textColorHint="#64748b"
            android:textSize="12.5sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAiSend"
            android:layout_width="60dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_cyan"
            android:text="Send"
            android:textAllCaps="false"
            android:textColor="#0369a1"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

