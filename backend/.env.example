# Port for backend server
PORT=3001

# SMTP Email Configuration (Gmail / Outlook / Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/silentsos
# Alternatively, individual connection parameters:
PGHOST=localhost
PGPORT=5432
PGDATABASE=silentsos
PGUSER=postgres
PGPASSWORD=postgres

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=SilentSOS <onboarding@resend.dev>
RESEND_SANDBOX_EMAIL=your_email@gmail.com
